{
  "AllowedHosts": "*",
  "Storage": {
    "InboxPath": "runtime/inbox",
    "DataPath": "runtime/data",
    "PollSeconds": 2,
    "MinimumAgeSeconds": 2,
    "MaximumFileMegabytes": 100
  },
  "Security": {
    "RequireHttps": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
